{
  "name": "@forgesworn/ring-sig",
  "version": "3.0.1",
  "description": "SAG and LSAG ring signatures on secp256k1 — prove group membership without revealing identity",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ring-signature",
    "sag",
    "lsag",
    "secp256k1",
    "zero-knowledge",
    "anonymous",
    "privacy",
    "nostr"
  ],
  "author": "Darren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/ring-sig.git"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "provenance": true
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:thedonkey@strike.me"
  }
}
